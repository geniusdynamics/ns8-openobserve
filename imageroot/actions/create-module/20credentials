#!/usr/bin/env python3
import os
import secrets
from pathlib import Path

os.umask(0o077)
path = Path(os.environ["AGENT_STATE_DIR"]) / "openobserve.env"
try:
    with path.open("x") as stream:
        stream.write("ZO_ROOT_USER_EMAIL=admin@example.org\n")
        stream.write("ZO_ROOT_USER_PASSWORD=" + secrets.token_urlsafe(32) + "aA1!\n")
except FileExistsError:
    pass
