# Generate the initial root user once. The file is created with mode 0600 from
# the start, never overwritten, and is included in the backup. The value is not
# written to Redis, argv, logs or action output.

import os
import secrets

path = os.path.join(os.environ["AGENT_STATE_DIR"], "openobserve.env")
try:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
except FileExistsError:
    raise SystemExit(0)
with os.fdopen(fd, "w") as stream:
    stream.write("ZO_ROOT_USER_EMAIL=admin@example.org\n")
    stream.write("ZO_ROOT_USER_PASSWORD=" + secrets.token_urlsafe(32) + "aA1!\n")
