import json
import sys
import agent
import os

data = json.load(sys.stdin)

# The same route serves the web UI and the ingestion API (/api/...), which
# is protected by OpenObserve authentication.
agent.set_route({
    'instance': os.environ['MODULE_ID'],
    'url': 'http://127.0.0.1:' + os.environ["TCP_PORT"],
    'host': data["host"],
    'http2https': data.get("http2https", True),
    'lets_encrypt': data.get("lets_encrypt", False),
})
