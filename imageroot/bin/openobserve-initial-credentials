#!/bin/bash
#
# Print the initial root credentials. Run on the node as root:
#   runagent -m openobserve1 openobserve-initial-credentials
# If the password was changed in the OpenObserve UI, this shows the original one.
set -e
umask 077
envfile="${AGENT_STATE_DIR}/openobserve.env"
[[ -r $envfile ]] || { echo "Credentials file not found" >&2; exit 1; }
sed -n -e 's/^ZO_ROOT_USER_EMAIL=/Email:    /p' -e 's/^ZO_ROOT_USER_PASSWORD=/Password: /p' "$envfile"
