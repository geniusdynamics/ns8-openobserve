#!/bin/bash
set -euo pipefail
umask 077
running=false
if systemctl --user is-active --quiet openobserve.service; then running=true; fi
finish() {
    status=$?
    rm -f "${tempfile:-}"
    if "$running"; then systemctl --user start openobserve.service || status=1; fi
    exit "$status"
}
trap finish EXIT
if "$running"; then systemctl --user stop openobserve.service; fi
tempfile=$(mktemp -p "$PWD")
podman unshare bash -ec 'tar --numeric-owner -C "$(podman volume mount openobserve-data)" -cpf "$1" .' bash "$tempfile"
mv -f "$tempfile" openobserve-data.tar
